# MIRA Configuration
# Copy this file to .env and fill in your values

# ==================== AI MODELS ====================

# Ollama (Local AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI (Cloud AI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ==================== ROBOT HARDWARE ====================

# ESP32 Robot IP Address
ROBOT_IP=192.168.1.100

# Serial Port (alternative to IP)
# ROBOT_SERIAL_PORT=COM5

# ==================== DATABASE ====================

# Database Path
DATABASE_PATH=knowledge_base/mira.db

# Memory Directory
MEMORY_DIR=memory

# ==================== BROWSER ====================

# Browser Type (chromium, firefox, webkit)
BROWSER_TYPE=chromium

# Headless Mode (true for background, false to show browser)
BROWSER_HEADLESS=false

# ==================== SERVER ====================

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (if separate)
FRONTEND_URL=http://localhost:3000

# ==================== PROJECT SETTINGS ====================

# Project Name
PROJECT_NAME=From Stones to AGI

# Content Language
CONTENT_LANGUAGE=en

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==================== OPTIONAL SERVICES ====================

# Hermes Agent API (if using)
# HERMES_API_URL=http://localhost:8001

# Vector Database (ChromaDB)
# CHROMA_PATH=chroma_db

# ==================== DEVELOPMENT ====================

# Development Mode
DEV_MODE=true

# Auto-reload
AUTO_RELOAD=true
