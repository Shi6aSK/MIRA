# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
*.o
*.a
*.out
*.exe # For any host-side utilities compiled on Windows

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
flasher_args.json # Generated in build directory
sdkconfig.old
sdkconfig

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# Gemma model weights (large binaries – download separately via HuggingFace)
gemma/*.safetensors
gemma/*.bin

# LaTeX report (not part of the firmware/code)
575_Latex_Template/

# User-specific configuration files
*.user
*.workspace # General workspace files, can be from various tools
*.suo       # Visual Studio Solution User Options
*.sln.docstates # Visual Studio

# Root-level media (served via docs/media/ instead)
/demo.mp4
/training.mp4
/MIRA_withmmWaveSensor_at_bottom.jpeg

# Tool outputs / captured frames
tools/last_frame.png
tools/__pycache__/
backend/__pycache__/

# sdkconfig (generated, contains secrets like Wi-Fi credentials)
sdkconfig

# Misc build/script artifacts
build_output.txt
script.md
partitions.csv

# Generated TTS audio files
*.wav

# IDE / editor configs
.clangd
.vscode/
.devcontainer/

# docs/media is tracked — do NOT ignore
!docs/
!docs/media/
